NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only for running fullschema.sql from a terminal:
#   psql "$SUPABASE_DB_URL" -f fullschema.sql
# Supabase -> Project Settings -> Database -> Connection string -> URI (session pooler, 5432).
# SUPABASE_DB_URL=

NEXT_PUBLIC_APP_URL=
ADMIN_VERIFICATION_CODE=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SMTP — required for the "forgot password" email.
# The app sends this itself rather than using Supabase's built-in sender, which
# only delivers to your own project team members and is capped at a couple of
# messages an hour. Any SMTP provider works (Resend, Brevo, SendGrid, Mailgun,
# Amazon SES, Gmail with an app password, your own server).
#
# SMTP_FROM is REQUIRED and must be a real address your provider has verified.
# Do not leave it blank hoping SMTP_USER will do: with Resend that value is the
# literal word "resend", and sending from it is rejected with
# "550 Invalid `from` field".
#
# Check everything with:  pnpm smtp:test -- --to you@example.com
#
# SMTP_SECURE is optional: it defaults to true on port 465 and false otherwise.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="The Mindset Meditation <noreply@your-domain.com>"
# SMTP_SECURE=          # optional: true on port 465, false on 587/25
